# Public application URL (without a trailing slash).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# One Firebase project is used by the browser, Firebase Admin and deployment.
# Replace these placeholders with your own project's public Firebase config.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-firebase-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-firebase-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Public direct-download URL from Firebase Storage for the PDF catalog.
# Leave empty until the file is uploaded; the waiting page will show an "coming soon" state.
NEXT_PUBLIC_CATALOG_PDF_URL=""

# Local server credentials only. Firebase App Hosting uses Application Default
# Credentials, so this must not be configured in production there.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"your-firebase-project",...}'
# Recommended local setup: run `npm run firebase:login` and choose a personal
# Google account that has access to the project. Some managed Workspace accounts
# require hourly reauthentication and are unsuitable for a long-running dev server.
# For another store, first update the SANPACK-specific project in firebase:login
# and review deployment configuration; copying this example does not connect it.
# Never store a downloaded service-account key in the project folder.

# Set to true only for an isolated demo that must use bundled sample content.
# Normal local development reads the connected Firebase project, and failed
# writes are never replaced with sample data.
SANPACK_USE_SEED_DATA="false"

# 24+ random characters used only by the server to encrypt Telegram tokens and
# client secrets, and to sign customer sessions. Configure the production value
# as an App Hosting secret and never change it without planning a session reset.
TELEGRAM_CONFIG_ENCRYPTION_KEY=""
