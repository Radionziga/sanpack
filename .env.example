# Public application URL (without a trailing slash).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# One Firebase project is used by the browser, Firebase Admin and deployment.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="stamply-4df8a.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="stamply-4df8a"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="stamply-4df8a.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Public direct-download URL from Firebase Storage for the SANPACK PDF catalog.
# Leave empty until the file is uploaded; the waiting page will show an "coming soon" state.
NEXT_PUBLIC_CATALOG_PDF_URL=""

# Comma-separated bootstrap allow-list. Prefer admins/{uid} documents in Firestore.
ADMIN_EMAILS=""

# Local server credentials only. Firebase App Hosting uses Application Default
# Credentials, so this must not be configured in production there.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"stamply-4df8a",...}'

# Explicit read-only seed fallback for local development or previews.
# Never makes a failed write look successful.
SANPACK_USE_SEED_DATA="true"
