rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All client access uses the Next server's explicit public projections or
    // authorized admin/customer APIs, never raw SDK/REST document access.
    // Runtime Admin SDK uses IAM and bypasses these client rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
