{
  "entities": {
    "Product": {
      "title": "Product Entity",
      "description": "Represents a catalog product in SANPACK",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "maxLength": 200 },
        "sku": { "type": "string", "maxLength": 100 },
        "titleRu": { "type": "string", "maxLength": 300 },
        "titleUz": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["draft", "published", "hidden", "archived"] },
        "categoryId": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "showPrice": { "type": "boolean" },
        "stockStatus": { "type": "string", "enum": ["in_stock", "out_of_stock", "on_order"] }
      },
      "required": ["slug", "sku", "titleRu", "titleUz", "status", "categoryId"]
    },
    "Category": {
      "title": "Category Entity",
      "description": "Represents a product category hierarchy",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "maxLength": 200 },
        "titleRu": { "type": "string", "maxLength": 200 },
        "titleUz": { "type": "string", "maxLength": 200 },
        "parentId": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "hidden"] }
      },
      "required": ["slug", "titleRu", "titleUz", "status"]
    },
    "Request": {
      "title": "B2B Request Entity",
      "description": "Represents a submitted B2B catalog quote request",
      "type": "object",
      "properties": {
        "number": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["new", "viewed", "in_progress", "clarification", "offer_sent", "completed", "canceled"] },
        "customer": { "type": "object" },
        "items": { "type": "array" }
      },
      "required": ["number", "status", "customer", "items"]
    },
    "SiteSettings": {
      "title": "Site Settings Entity",
      "description": "Global application configuration",
      "type": "object",
      "properties": {
        "salesMode": { "type": "string", "enum": ["request_only", "ecommerce"] },
        "company": { "type": "object" },
        "contacts": { "type": "object" }
      },
      "required": ["salesMode", "company", "contacts"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Catalog products collection"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Categories collection"
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/Request" },
      "description": "Customer quote requests"
    },
    "/settings/global": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Global site settings document"
    }
  }
}
